# Supabase Configuration
# These are example values - DO NOT use these in production!
# Copy this file to .env and replace with your actual Supabase credentials

# Your Supabase Project ID
# Find this in your Supabase dashboard: Project Settings > General > Reference ID
VITE_SUPABASE_PROJECT_ID="your-project-id-here"

# Your Supabase Publishable/Anon Key
# Find this in your Supabase dashboard: Project Settings > API > Project API keys > anon public
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key-here"

# Your Supabase Project URL
# Find this in your Supabase dashboard: Project Settings > API > Project URL
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Sentry Configuration (Error Tracking & Performance Monitoring)
# Leave blank to disable Sentry in development
# See docs/SENTRY_SETUP.md for detailed setup instructions

# Your Sentry DSN (Data Source Name)
# Find this in Sentry dashboard: Settings > Projects > [Your Project] > Client Keys (DSN)
# This is the only REQUIRED variable to enable Sentry error tracking
VITE_SENTRY_DSN=""

# Build-time Sentry Configuration (for uploading source maps)
# These are ONLY needed for production builds to upload source maps
# They are NOT prefixed with VITE_ as they're used at build time, not runtime

# Your Sentry Auth Token
# Create at: Sentry dashboard > Settings > Auth Tokens
# Required scopes: project:releases, project:write
SENTRY_AUTH_TOKEN=""

# Your Sentry Organization Slug
# Find in: Sentry dashboard > Settings > General Settings > Organization Slug
SENTRY_ORG=""

# Your Sentry Project Slug
# Find in: Sentry dashboard > Settings > Projects > [Your Project] > General Settings
SENTRY_PROJECT=""
